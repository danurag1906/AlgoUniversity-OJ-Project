PORT=3001
MONGODB_URI=mongodb://localhost:27017/myapp
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name

# AI Integration
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# Code execution timeouts (milliseconds)
# TIME_LIMIT_MS: per-testcase execution timeout (default 5000; use 15000 on EC2 t3.micro)
# COMPILE_TIMEOUT_MS: C++/Java compilation timeout (default 30000; increase if images are not pre-pulled)
TIME_LIMIT_MS=5000
COMPILE_TIMEOUT_MS=30000
